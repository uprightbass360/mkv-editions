{
  "name": "mkv-editions-app",
  "private": true,
  "version": "0.1.0",
  "repository": { "type": "git", "url": "https://github.com/uprightbass360/mkv-editions.git" },
  "workspaces": [
    "renderer"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsup",
    "build:renderer": "npm run build --workspace renderer",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "dev:renderer": "npm run dev --workspace renderer -- --port 5173",
    "dev:electron": "npm run build:electron && cross-env ELECTRON_RENDERER_DEV_URL=http://localhost:5173 electron .",
    "test:electron": "vitest run",
    "test:renderer": "npm run test --workspace renderer",
    "test": "npm run test:electron && npm run test:renderer",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.mkveditions.workbench",
    "productName": "mkv-editions",
    "files": ["dist-electron/**/*", "renderer/build/**/*", "package.json"],
    "extraResources": [{ "from": "../src/gen-editions.py", "to": "cli/gen-editions.py" }],
    "linux": { "target": ["AppImage"], "category": "AudioVideo" },
    "publish": { "provider": "github", "owner": "uprightbass360", "repo": "mkv-editions" }
  }
}
